# Hindsight Cloud or self-hosted API credentials. Never commit a populated .env.
HINDSIGHT_API_KEY=
HINDSIGHT_BASE_URL=http://localhost:8888
HINDSIGHT_BANK_ID=incidentmind

# Groq configuration used by Phase 3 and later.
GROQ_API_KEY=
MODEL_NAME=openai/gpt-oss-120b

# Optional SQLite URL for incident records.
DATABASE_URL=sqlite:///./data/incidents.sqlite3

# Phase 7 experimental features are disabled unless explicitly enabled.
CHAOS_DOJO_ENABLED=false
STALENESS_ENABLED=false
DEPLOY_RISK_ENABLED=false

